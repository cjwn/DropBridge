; DropBridge: bind the Wi-Fi interface of the RTL8821CU (0bda:c820, MI_02) to
; the in-box WinUSB driver, so libusb can open it without replacing anything
; else on the device. Built and signed by tools\Build-DriverPackage.ps1.
;
; Deliberately narrow: one hardware id, one interface. MI_00 (Bluetooth) and the
; composite parent are not mentioned, so they keep their drivers.

[Version]
Signature = "$Windows NT$"
Class     = USBDevice
ClassGuid = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider  = %PROVIDER%
CatalogFile = airbridge-winusb.cat
DriverVer = 10/31/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%PROVIDER% = DeviceList,NTamd64

[DeviceList.NTamd64]
%DEVICE% = Install, USB\VID_0BDA&PID_C820&MI_02

[Install.NTamd64]
Include = winusb.inf
Needs   = WINUSB.NT

[Install.NTamd64.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[Install.NTamd64.HW]
AddReg = AddInterfaceGuid

[AddInterfaceGuid]
HKR,,DeviceInterfaceGUIDs,0x00010000,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"

[Strings]
PROVIDER = "DropBridge"
DEVICE   = "DropBridge AWDL radio (RTL8821CU Wi-Fi interface)"
