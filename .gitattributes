* text=auto
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.json text eol=lf
# Patches are applied with `git apply`, which matches context byte-for-byte; a
# CRLF checkout (core.autocrlf=true) makes them fail against the LF upstream.
# One-space context lines belong to patch syntax, not source whitespace.
*.patch -text -whitespace
