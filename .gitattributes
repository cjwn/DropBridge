* text=auto
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.json text eol=lf
# Patches are applied with `git apply`, which matches context byte-for-byte; a
# CRLF checkout (core.autocrlf=true) makes them fail against the LF upstream.
# One-space context lines belong to patch syntax, not source whitespace.
*.patch -text -whitespace
# The signed catalog (.cat) holds the SHA-1 of the INF's exact LF bytes; any
# EOL conversion on checkout breaks the signature, so never touch these.
packaging/driver/*.inf -text
*.cat binary
*.cer binary
