diff --git a/src/ChannelSwitchCompletion.h b/src/ChannelSwitchCompletion.h
new file mode 100644
index 0000000..7324c43
--- /dev/null
+++ b/src/ChannelSwitchCompletion.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#pragma once
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+namespace devourer {
+// One control caller, one outstanding H2C. RX notification takes no register
+// lock, so a waiter may hold the register lock while the RX ring keeps draining.
+class ChannelSwitchCompletion {
+public:
+  void arm() {
+    std::lock_guard<std::mutex> lock(mu_);
+    armed_ = true;
+    done_ = false;
+  }
+  void notify(const uint8_t *data, size_t size) {
+    // Realtek original C2H: command ID, sequence, optional payload. 0x10 is
+    // CUR_CHANNEL (halmac_original_c2h_nic.h); never accept an extended C2H.
+    if (!data || size < 2 || data[0] != 0x10) return;
+    std::lock_guard<std::mutex> lock(mu_);
+    if (armed_) { done_ = true; cv_.notify_one(); }
+  }
+  bool wait(unsigned milliseconds) {
+    std::unique_lock<std::mutex> lock(mu_);
+    const bool completed = cv_.wait_for(lock, std::chrono::milliseconds(milliseconds),
+                                        [&] { return done_; });
+    armed_ = false;
+    return completed;
+  }
+private:
+  std::mutex mu_;
+  std::condition_variable cv_;
+  bool armed_ = false, done_ = false;
+};
+}
