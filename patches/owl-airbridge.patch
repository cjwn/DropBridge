 static void awdl_election_reset_metric(struct awdl_election_state *state) {
+	/* AirBridge32: a peer is accepted when its metric is higher, so a higher
+	 * self metric makes this node the sync master and lets it dictate an
+	 * all-149 MHz sequence (the fast path). Opt-in via env. */
+	const char *metric = getenv("AWDL_ELECTION_METRIC");
 	state->self_counter = AWDL_ELECTION_COUNTER_INIT;
-	state->self_metric = AWDL_ELECTION_METRIC_INIT;
+	state->self_metric = metric ? (uint32_t) strtoul(metric, NULL, 10)
+	                            : AWDL_ELECTION_METRIC_INIT;
 }
 
