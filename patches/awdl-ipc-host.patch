+def stable_service_id(address):
+    """A stable 12-hex AirDrop instance ID derived from the AWDL IPv6 IID.
+
+    The upstream implementation used a fresh secrets.token_hex(6) on every
+    start, so iPhone treated each launch as a new receiver and had to
