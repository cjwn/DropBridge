diff --git a/awdl/win/host_if_ipc.c b/awdl/win/host_if_ipc.c
new file mode 100644
index 0000000..81979a1
--- /dev/null
+++ b/awdl/win/host_if_ipc.c
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* IPC host backend for the user-space AWDL data plane PoC.
+ *
+ * Instead of creating a Wintun adapter, this connects to awdl_netd on
+ * 127.0.0.1:49877 and exchanges raw IPv6 packets. awdl_netd runs lwIP and
+ * proxies AirDrop's TCP 8771 to the local receiver, so the Windows IPv6
+ * stack (and any v2ray TUN) is not involved. */
+#define WIN32_LEAN_AND_MEAN
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+
+#include "host_if.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define IPC_PORT 49877
+#define IPC_CONNECT_TRIES 200
+
+struct host_if {
+    SOCKET sock;
+    WSAEVENT event;
+    uint8_t header[2];
+    int header_got;
+    uint8_t packet[HOST_IF_MAX_PACKET];
+    int packet_len;
+    int packet_got;
+};
+
+static int send_all(SOCKET sock, const uint8_t *data, int len) {
+    while (len > 0) {
+        int n = send(sock, (const char *) data, len, 0);
+        if (n > 0) {
+            data += n;
+            len -= n;
+            continue;
+        }
+        if (n < 0 && WSAGetLastError() == WSAEWOULDBLOCK) {
+            Sleep(1);
+            continue;
+        }
+        return -1;
+    }
+    return 0;
+}
+
+struct host_if *host_if_open(const uint8_t address[16], char *error, size_t error_len) {
+    WSADATA wsa;
+    if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0) {
+        snprintf(error, error_len, "WSAStartup failed");
+        return NULL;
+    }
+    struct host_if *host = (struct host_if *) calloc(1, sizeof(*host));
+    if (!host) return NULL;
+    host->sock = INVALID_SOCKET;
+    host->event = WSA_INVALID_EVENT;
+
+    host->sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (host->sock == INVALID_SOCKET) {
+        snprintf(error, error_len, "socket failed (%d)", WSAGetLastError());
+        host_if_close(host);
+        return NULL;
+    }
+
+    struct sockaddr_in addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(IPC_PORT);
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+    int connected = 0;
+    for (int i = 0; i < IPC_CONNECT_TRIES; i++) {
+        if (connect(host->sock, (const struct sockaddr *) &addr, sizeof(addr)) == 0) {
+            connected = 1;
+            break;
+        }
+        if (WSAGetLastError() != WSAECONNREFUSED &&
+            WSAGetLastError() != WSAETIMEDOUT) {
+            break;
+        }
+        Sleep(100);
+    }
+    if (!connected) {
+        snprintf(error, error_len, "awdl_netd not reachable on 127.0.0.1:%d", IPC_PORT);
+        host_if_close(host);
+        return NULL;
+    }
+
+    uint8_t hello[20];
+    memcpy(hello, "AWDL", 4);
+    memcpy(hello + 4, address, 16);
+    if (send_all(host->sock, hello, sizeof(hello)) != 0) {
+        snprintf(error, error_len, "handshake write failed");
+        host_if_close(host);
+        return NULL;
+    }
+
+    host->event = WSACreateEvent();
+    if (host->event == WSA_INVALID_EVENT ||
+        WSAEventSelect(host->sock, host->event, FD_READ | FD_CLOSE) == SOCKET_ERROR) {
+        snprintf(error, error_len, "event setup failed (%d)", WSAGetLastError());
+        host_if_close(host);
+        return NULL;
+    }
+    u_long nonblocking = 1;
+    ioctlsocket(host->sock, FIONBIO, &nonblocking);
+    return host;
+}
+
+void host_if_close(struct host_if *host) {
+    if (!host) return;
+    if (host->event != WSA_INVALID_EVENT) WSACloseEvent(host->event);
+    if (host->sock != INVALID_SOCKET) closesocket(host->sock);
+    free(host);
+    WSACleanup();
+}
+
+void *host_if_read_event(const struct host_if *host) {
+    return (void *) host->event;
+}
+
+unsigned long host_if_index(const struct host_if *host) {
+    (void) host;
+    return 1;
+}
+
+int host_if_read(struct host_if *host, uint8_t *packet) {
+    if (!host) return 0;
+    for (;;) {
+        if (host->header_got < 2) {
+            int n = recv(host->sock, (char *) host->header + host->header_got,
+                         2 - host->header_got, 0);
+            if (n > 0) {
+                host->header_got += n;
+                if (host->header_got == 2) {
+                    host->packet_len = host->header[0] | (host->header[1] << 8);
+                    host->packet_got = 0;
+                    if (host->packet_len <= 0 || host->packet_len > HOST_IF_MAX_PACKET) {
+                        return 0;
+                    }
+                }
+                continue;
+            }
+            if (n < 0 && WSAGetLastError() == WSAEWOULDBLOCK) return 0;
+            return 0;
+        }
+
+        int n = recv(host->sock, (char *) host->packet + host->packet_got,
+                     host->packet_len - host->packet_got, 0);
+        if (n > 0) {
+            host->packet_got += n;
+            if (host->packet_got == host->packet_len) {
+                memcpy(packet, host->packet, (size_t) host->packet_len);
+                int len = host->packet_len;
+                host->header_got = 0;
+                host->packet_len = 0;
+                host->packet_got = 0;
+                return len;
+            }
+            continue;
+        }
+        if (n < 0 && WSAGetLastError() == WSAEWOULDBLOCK) return 0;
+        return 0;
+    }
+}
+
+int host_if_write(struct host_if *host, const uint8_t *packet, int len) {
+    if (!host || len <= 0 || len > HOST_IF_MAX_PACKET) return -1;
+    uint8_t header[2] = { (uint8_t) (len & 0xff), (uint8_t) ((len >> 8) & 0xff) };
+    if (send_all(host->sock, header, sizeof(header)) != 0) return -1;
+    if (send_all(host->sock, packet, len) != 0) return -1;
+    return 0;
+}
